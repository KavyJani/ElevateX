# External PostgreSQL. Do not point this at the managed MySQL DATABASE_URL.
ELEVATEX_DATABASE_URL=postgresql://elevatex:local_only_change_me@localhost:5432/elevatex?schema=public

# Email adapter accepted by the backend (Bearer auth, JSON {from,to,subject,text}).
ELEVATEX_EMAIL_API_URL=
ELEVATEX_EMAIL_API_KEY=
ELEVATEX_EMAIL_FROM=
ELEVATEX_CONTACT_TO=
ELEVATEX_PUBLIC_ORIGIN=https://your-public-elevatex-origin.example

# Manus-managed Cloud Preview supplies the server-only MANUS_API_URL/MANUS_API_KEY
# for INVESTO and private file storage. Do not expose them as NEXT_PUBLIC variables.
PORT=3001
NEXT_PUBLIC_APP_NAME=ElevateX

# For the one-time CLI-only admin bootstrap, set these only during that command,
# then remove them. Bootstrap is refused when an ADMIN already exists.
ELEVATEX_ALLOW_ADMIN_BOOTSTRAP=false
ELEVATEX_ADMIN_EMAIL=
ELEVATEX_ADMIN_NAME=
ELEVATEX_ADMIN_PASSWORD=
